NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=packet-documents
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-fable-5
# Which model runs packet extraction: "openai" or "anthropic"
EXTRACTION_PROVIDER=openai
# Max packet extraction runs (upload + rerun) per organization per hour
EXTRACTION_RATE_LIMIT_PER_HOUR=20
# Max teammate invites per organization per hour (each sends a real email)
INVITE_RATE_LIMIT_PER_HOUR=20
# Max members per workspace
MAX_ORG_MEMBERS=25
# Required in production: protects /api/cron/* routes (Vercel sends it automatically)
CRON_SECRET=
# Optional: enables the deadline digest emails (dry run without it)
RESEND_API_KEY=
EMAIL_FROM=
# Production origin used in invite/reset email links (falls back to the request origin)
NEXT_PUBLIC_SITE_URL=
